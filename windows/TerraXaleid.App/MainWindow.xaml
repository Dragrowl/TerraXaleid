<Window x:Class="TerraXaleid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="#F7F7F5"
        FontFamily="Microsoft YaHei UI"
        Title="TerraXaleid" Height="720" Width="1040"
        WindowStartupLocation="CenterScreen">
    <!-- Colours are spelled out instead of pulled from MaterialDesign brush keys: the package
         renames those between major versions, and a missing key only shows up as a runtime
         StaticResource exception. Control styling still comes from the bundled theme. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择世界" FontSize="30" FontWeight="SemiBold" Foreground="#1B1B1B" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,16">
            <TextBox x:Name="SearchBox" Width="380" Height="52"
                     materialDesign:HintAssist.Hint="搜索世界名称"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     VerticalAlignment="Center"
                     TextChanged="OnSearchChanged" />
            <Button x:Name="RefreshButton" Content="刷新" Click="OnRefresh"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                    Margin="12,8,0,0" Height="36" Padding="18,0"
                    VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="WorldList">
                <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFFFF" BorderBrush="#E4E4DF" BorderThickness="1"
                            CornerRadius="12" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#1B1B1B" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="#EFEFEA" CornerRadius="9" Padding="9,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Difficulty}" FontSize="12" Foreground="#33332F" />
                                </Border>
                                <Border Background="#EFEFEA" CornerRadius="9" Padding="9,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Size}" FontSize="12" Foreground="#33332F" />
                                </Border>
                                <Border Background="#EFEFEA" CornerRadius="9" Padding="9,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Evil}" FontSize="12" Foreground="#33332F" />
                                </Border>
                                <TextBlock Text="{Binding Progress}" FontSize="12" Foreground="#6A6A64" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0" FontSize="12"
                   Foreground="#6A6A64" TextWrapping="Wrap" />
    </Grid>
</Window>
