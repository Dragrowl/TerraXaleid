<Window x:Class="TerraXaleid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{DynamicResource App.Background}"
        FontFamily="Microsoft YaHei UI"
        Title="TerraXaleid" Height="760" Width="1120"
        WindowStartupLocation="CenterScreen">
    <!-- Layout mirrors the Android build: a left icon rail carries everything the phone keeps in
         its overflow menu (refresh / backups / settings), the right side is the page area. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── rail ─────────────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource App.Rail}" Padding="10,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="NavWorlds" Style="{StaticResource RailButton}" Click="OnNavWorlds">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource RailTip}" Content="世界列表" />
                        </Button.ToolTip>
                        <materialDesign:PackIcon Kind="Earth" Width="22" Height="22"
                                                 Foreground="{DynamicResource App.Text}" />
                    </Button>

                    <Button x:Name="NavBackups" Style="{StaticResource RailButton}" Click="OnNavBackups">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource RailTip}" Content="恢复与备份" />
                        </Button.ToolTip>
                        <materialDesign:PackIcon Kind="BackupRestore" Width="22" Height="22"
                                                 Foreground="{DynamicResource App.Text}" />
                    </Button>

                    <Button x:Name="NavSettings" Style="{StaticResource RailButton}" Click="OnNavSettings">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource RailTip}" Content="设置" />
                        </Button.ToolTip>
                        <materialDesign:PackIcon Kind="Cog" Width="22" Height="22"
                                                 Foreground="{DynamicResource App.Text}" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="RailRefresh" Style="{StaticResource RailButton}" Click="OnRefresh">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource RailTip}" Content="刷新" />
                        </Button.ToolTip>
                        <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22"
                                                 Foreground="{DynamicResource App.Text}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── pages ────────────────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="28,20,28,16">

            <!-- worlds -->
            <Grid x:Name="PageWorlds">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="选择世界" FontSize="30" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Text}" />

                <Grid Grid.Row="1" Margin="0,14,0,16">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="SearchHint" Text="搜索世界名称" Margin="16,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource App.TextSoft}" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="WorldList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource App.Text}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border Background="{DynamicResource App.Chip}" CornerRadius="9" Padding="9,3" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Difficulty}" FontSize="12" Foreground="{DynamicResource App.Text}" />
                                            </Border>
                                            <Border Background="{DynamicResource App.Chip}" CornerRadius="9" Padding="9,3" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Size}" FontSize="12" Foreground="{DynamicResource App.Text}" />
                                            </Border>
                                            <Border Background="{DynamicResource App.Chip}" CornerRadius="9" Padding="9,3" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Evil}" FontSize="12" Foreground="{DynamicResource App.Text}" />
                                            </Border>
                                            <TextBlock Text="{Binding Progress}" FontSize="12"
                                                       Foreground="{DynamicResource App.TextSoft}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" FontSize="12"
                           Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
            </Grid>

            <!-- backups -->
            <Grid x:Name="PageBackups" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="恢复与备份" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource App.Text}" />

                <TextBlock Grid.Row="1" Margin="0,10,0,16" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource App.TextSoft}"
                           Text="覆盖地图前都会留一份 .map.bak（旧备份依次编号 .bak.1、.bak.2）。恢复会把备份写回该角色的地图文件。" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BackupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource App.Text}" Text="{Binding Title}" />
                                            <TextBlock FontSize="12" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource App.TextSoft}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="恢复" Height="32" Padding="14,0" Margin="0,0,8,0"
                                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                                    Tag="{Binding}" Click="OnRestoreBackup" />
                                            <Button Content="删除" Height="32" Padding="14,0"
                                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                                    Tag="{Binding}" Click="OnDeleteBackup" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="BackupStatus" Grid.Row="3" Margin="0,12,0,0" FontSize="12"
                           Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
            </Grid>

            <!-- settings -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="设置" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,10">
                        <StackPanel>
                            <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                            <TextBlock Text="选择配色，切换立即生效。" FontSize="12" Margin="0,6,0,12"
                                       Foreground="{DynamicResource App.TextSoft}" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ThemeSystem" Content="跟随系统" Height="34" Padding="16,0" Margin="0,0,8,0"
                                        Style="{DynamicResource MaterialDesignOutlinedButton}" Tag="system" Click="OnThemeClick" />
                                <Button x:Name="ThemeLight" Content="浅色" Height="34" Padding="16,0" Margin="0,0,8,0"
                                        Style="{DynamicResource MaterialDesignOutlinedButton}" Tag="light" Click="OnThemeClick" />
                                <Button x:Name="ThemeDark" Content="深色" Height="34" Padding="16,0"
                                        Style="{DynamicResource MaterialDesignOutlinedButton}" Tag="dark" Click="OnThemeClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                            <TextBlock x:Name="AboutText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.TextSoft}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
