<Window x:Class="TerraXaleid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Background="{DynamicResource App.Background}"
        FontFamily="{DynamicResource App.FontFamily}"
        Icon="Assets/app.ico"
        Title="TerraXaleid"
        Height="760" Width="1120" MinHeight="380" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowKeyDown"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <!-- Native chrome is suppressed on purpose: the app draws its own 44 px title bar, and
         WindowChrome keeps the resize borders + snap behaviour working. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{x:Static NavigationCommands.Refresh}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static NavigationCommands.Refresh}" Executed="OnRefreshCommand" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── title bar ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Background="{DynamicResource App.Surface}">
            <TextBlock Text="{DynamicResource App.Title}" Margin="18,0,0,0" VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" Click="OnMinimize">
                    <Button.ToolTip><ToolTip Style="{StaticResource RailTip}" Content="{DynamicResource Win.Minimize}" /></Button.ToolTip>
                    <Path Data="M0,0 H10" Stroke="{DynamicResource App.Text}" StrokeThickness="1.2" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButton}" Click="OnMaximize">
                    <Button.ToolTip><ToolTip Style="{StaticResource RailTip}" Content="{DynamicResource Win.Maximize}" /></Button.ToolTip>
                    <Rectangle Width="9" Height="9" Stroke="{DynamicResource App.Text}" StrokeThickness="1.2" />
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource CaptionClose}" Click="OnClose">
                    <Button.ToolTip><ToolTip Style="{StaticResource RailTip}" Content="{DynamicResource Win.Close}" /></Button.ToolTip>
                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource App.Text}" StrokeThickness="1.2" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── rail: worlds / backups / refresh on top, settings at the bottom ── -->
            <Border Grid.Column="0" Background="{DynamicResource App.Rail}" Padding="10,14,10,14">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="NavWorlds" Style="{StaticResource RailButton}" Click="OnNavWorlds">
                            <Button.ToolTip><ToolTip Style="{StaticResource RailTip}" Content="{DynamicResource Nav.Worlds}" /></Button.ToolTip>
                            <materialDesign:PackIcon Kind="Earth" Width="22" Height="22" Foreground="{DynamicResource App.Text}" />
                        </Button>
                        <Button x:Name="NavBackups" Style="{StaticResource RailButton}" Click="OnNavBackups">
                            <Button.ToolTip><ToolTip Style="{StaticResource RailTip}" Content="{DynamicResource Nav.Backups}" /></Button.ToolTip>
                            <materialDesign:PackIcon Kind="BackupRestore" Width="22" Height="22" Foreground="{DynamicResource App.Text}" />
                        </Button>
                        <Button x:Name="NavRefresh" Style="{StaticResource RailButton}" Click="OnRefresh">
                            <Button.ToolTip><ToolTip Style="{StaticResource RailTip}" Content="{DynamicResource Nav.Refresh}" /></Button.ToolTip>
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" Foreground="{DynamicResource App.Text}" />
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="NavSettings" Style="{StaticResource RailButton}" Click="OnNavSettings">
                            <Button.ToolTip><ToolTip Style="{StaticResource RailTip}" Content="{DynamicResource Nav.Settings}" /></Button.ToolTip>
                            <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" Foreground="{DynamicResource App.Text}" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── pages ────────────────────────────────────────────────── -->
            <Grid Grid.Column="1">

                <!-- level 1: worlds -->
                <Grid x:Name="PageWorlds">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Floating search: it hovers over the grid instead of eating a full row. -->
                    <Grid x:Name="SearchHost" Panel.ZIndex="2" Width="320" Margin="0,14,20,0"
                          HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" />
                        <TextBlock x:Name="SearchHint" Text="{DynamicResource Worlds.Search}" Margin="20,0"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   FontSize="{DynamicResource App.Font.Body}"
                                   Foreground="{DynamicResource App.TextSoft}" />
                    </Grid>

                    <TextBlock x:Name="WorldEmpty" Text="{DynamicResource Worlds.NoMatch}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0"
                               FontSize="{DynamicResource App.Font.Body}" Foreground="{DynamicResource App.TextSoft}"
                               Visibility="Collapsed" />
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="20,66,0,12">
                        <ItemsControl x:Name="WorldList" Margin="0,0,8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="0"
                                                 Columns="{Binding WorldColumns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,12"
                                            MouseLeftButtonUp="OnWorldCardClick" Cursor="Hand"
                                            Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                                            KeyDown="OnWorldCardKeyDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource Worlds.Menu.Open}" Click="OnWorldMenuOpen" Tag="{Binding}" />
                                                <MenuItem Header="{DynamicResource Worlds.Menu.Tick}" Click="OnWorldMenuTick" Tag="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Worlds.Menu.Folder}" Click="OnWorldMenuFolder" Tag="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource App.Chip}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource App.Font.Body}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.Text}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Border Background="{DynamicResource App.Chip}" CornerRadius="9" Padding="9,3" Margin="0,0,8,6">
                                                    <TextBlock Text="{Binding Difficulty}" FontSize="{DynamicResource App.Font.Meta}" Foreground="{DynamicResource App.Text}" />
                                                </Border>
                                                <Border Background="{DynamicResource App.Chip}" CornerRadius="9" Padding="9,3" Margin="0,0,8,6">
                                                    <TextBlock Text="{Binding Size}" FontSize="{DynamicResource App.Font.Meta}" Foreground="{DynamicResource App.Text}" />
                                                </Border>
                                                <Border Background="{DynamicResource App.Chip}" CornerRadius="9" Padding="9,3" Margin="0,0,8,6">
                                                    <TextBlock Text="{Binding Evil}" FontSize="{DynamicResource App.Font.Meta}" Foreground="{DynamicResource App.Text}" />
                                                </Border>
                                            </WrapPanel>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Progress}" FontSize="{DynamicResource App.Font.Meta}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource App.TextSoft}" />
                                                <TextBlock Text="{Binding MapsText}" FontSize="{DynamicResource App.Font.Meta}" HorizontalAlignment="Right"
                                                           TextWrapping="NoWrap" Opacity="0.75"
                                                           Foreground="{DynamicResource App.TextSoft}" />
                                            </Grid>
                                            </StackPanel>
                                            <!-- Two-way bound: the row owns the state, so a press anywhere on the
                                                 tick only ever flips that one card. -->
                                            <ToggleButton Grid.Column="1" Style="{StaticResource SelectToggle}" Margin="10,0,0,0"
                                                          VerticalAlignment="Top" Background="Transparent"
                                                          BorderThickness="0" Cursor="Hand" Focusable="False"
                                                          ToolTip="{DynamicResource Worlds.BatchPick}"
                                                          IsChecked="{Binding Selected, Mode=TwoWay}">
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.TextSoft}" />
                                                            <Setter Property="Opacity" Value="0.45" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="20,10,16,0" FontSize="{DynamicResource App.Font.Meta}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{DynamicResource App.TextSoft}" />
                </Grid>

                <!-- level 2: characters of one world -->
                <Grid x:Name="PageCharacters" Margin="24,18,24,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Click="OnBackToWorlds" Style="{StaticResource RailButton}" Margin="0,0,10,0">
                            <Button.ToolTip><ToolTip Style="{StaticResource RailTip}" Content="{DynamicResource Common.Back}" /></Button.ToolTip>
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" Foreground="{DynamicResource App.Text}" />
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Chars.Title}" FontSize="{DynamicResource App.Font.Page}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Text}" />
                            <TextBlock x:Name="CharacterWorldName" FontSize="{DynamicResource App.Font.Body}" Margin="0,2,0,0"
                                       Foreground="{DynamicResource App.TextSoft}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,12">
                        <TextBlock Text="{DynamicResource Chars.Hint}" FontSize="{DynamicResource App.Font.Body}"
                                   Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
                        <TextBlock x:Name="CharacterTemplate" FontSize="{DynamicResource App.Font.Body}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CharacterList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="320" Margin="0,0,12,12" Cursor="Hand"
                                            PreviewMouseLeftButtonUp="OnCharacterCardClick">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource Chars.Undo}" Click="OnCharacterMenuUndo" Tag="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource App.Chip}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource App.Text}" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource App.Font.Body}" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource App.TextSoft}" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Guid}" FontSize="11" Margin="0,4,0,0" Opacity="0.6"
                                                               Foreground="{DynamicResource App.TextSoft}" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="&#x2713;" FontSize="14"
                                                           VerticalAlignment="Top" Margin="8,2,0,0"
                                                           Visibility="{Binding TickVisibility}"
                                                           Foreground="{DynamicResource App.Accent}" />
                                            </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Bottom">
                        <TextBlock x:Name="CharacterSelection" VerticalAlignment="Center" FontSize="{DynamicResource App.Font.Body}"
                                   Foreground="{DynamicResource App.TextSoft}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="UndoButton" Content="{DynamicResource Chars.Undo}" Margin="0,0,8,0"
                                    Style="{StaticResource PillButtonOutline}" Click="OnUndoClick"
                                    Visibility="Collapsed" />
                            <Button x:Name="PickButton" Content="{DynamicResource Chars.Pick}"
                                    Style="{StaticResource PillButton}" Click="OnPickClick" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- backups -->
                <Grid x:Name="PageBackups" Margin="24,18,24,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Backups.Title}" FontSize="{DynamicResource App.Font.Page}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" />
                    <TextBlock Grid.Row="1" Text="{DynamicResource Backups.Hint}" FontSize="{DynamicResource App.Font.Body}" Margin="0,8,0,14"
                               TextWrapping="Wrap" Foreground="{DynamicResource App.TextSoft}" />

                    <TextBlock x:Name="BackupEmpty" Text="{DynamicResource Backups.Empty}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                               FontSize="{DynamicResource App.Font.Body}" Foreground="{DynamicResource App.TextSoft}"
                               Visibility="Collapsed" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="BackupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource App.Chip}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource App.Text}" Text="{Binding Title}" />
                                                <TextBlock FontSize="{DynamicResource App.Font.Body}" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource App.TextSoft}" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Margin="0,0,8,0" Tag="{Binding}"
                                                        Content="{DynamicResource Backups.Restore}"
                                                        Style="{StaticResource PillButton}" Click="OnRestoreBackup" />
                                                <Button Margin="0,0,8,0" Tag="{Binding}"
                                                        Content="{DynamicResource Backups.Delete}"
                                                        Style="{StaticResource PillButtonOutline}" Click="OnDeleteBackup" />
                                                <Button Tag="{Binding}"
                                                        Content="{DynamicResource Backups.DeleteMap}"
                                                        Style="{StaticResource PillButtonDanger}" Click="OnDeleteMap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="BackupStatus" Grid.Row="3" Margin="0,10,0,0" FontSize="{DynamicResource App.Font.Meta}"
                               Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
                </Grid>

                <!-- settings: two free-stacking columns; no card is forced to a fixed height -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,18,24,14">
                        <TextBlock Text="{DynamicResource Settings.Title}" FontSize="{DynamicResource App.Font.Page}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text}" />

                        <WrapPanel Margin="0,14,0,0">
    <!-- appearance: three fixed 3:2 tiles; the card keeps a floor width so they never squeeze -->
    <Border Style="{StaticResource CardBorder}" Width="470" Margin="0,0,12,12">
        <StackPanel>
            <TextBlock Text="{DynamicResource Settings.Appearance}" FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.Text}" />
            <TextBlock Text="{DynamicResource Settings.Appearance.Hint}" FontSize="{DynamicResource App.Font.Body}" Margin="0,6,0,14"
                       Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
            <UniformGrid Columns="3">
                <Button x:Name="ThemeSystem" Style="{StaticResource ThemeChoice}" Tag="system" Click="OnThemeClick" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Width="132" Height="88" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Center">
                            <Image Source="Assets/theme_preview_auto.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{DynamicResource Settings.Theme.System}" FontSize="{DynamicResource App.Font.Meta}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource App.TextSoft}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeLight" Style="{StaticResource ThemeChoice}" Tag="light" Click="OnThemeClick" Margin="4,0,4,0">
                    <StackPanel>
                        <Border Width="132" Height="88" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Center">
                            <Image Source="Assets/theme_preview_light.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{DynamicResource Settings.Theme.Light}" FontSize="{DynamicResource App.Font.Meta}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource App.TextSoft}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeDark" Style="{StaticResource ThemeChoice}" Tag="dark" Click="OnThemeClick" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Width="132" Height="88" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Center">
                            <Image Source="Assets/theme_preview_dark.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{DynamicResource Settings.Theme.Dark}" FontSize="{DynamicResource App.Font.Meta}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource App.TextSoft}" />
                    </StackPanel>
                </Button>
            </UniformGrid>
            <StackPanel x:Name="VariantRow" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                <Button x:Name="DarkStandard" Style="{StaticResource PillButtonOutline}" Margin="0,0,8,0"
                        Tag="standard" Click="OnVariantClick" Content="{DynamicResource Settings.Variant.Standard}" />
                <Button x:Name="DarkOled" Style="{StaticResource PillButtonOutline}"
                        Tag="oled" Click="OnVariantClick" Content="{DynamicResource Settings.Variant.Oled}" />
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- language -->
    <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,12,12">
        <StackPanel>
            <TextBlock Text="{DynamicResource Settings.Language}" FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.Text}" />
            <TextBlock Text="{DynamicResource Settings.Language.Hint}" FontSize="{DynamicResource App.Font.Body}" Margin="0,6,0,12"
                       Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
            <Border x:Name="LanguageField" Height="36" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource App.Border}" Background="{DynamicResource App.Surface}">
                <Grid>
                    <TextBlock x:Name="LanguageLabel" Margin="12,0,36,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource App.Font.Body}" Foreground="{DynamicResource App.Text}"
                               TextTrimming="CharacterEllipsis" />
                    <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Margin="0,0,10,0"
                                             Foreground="{DynamicResource App.TextSoft}" />
                    <Button x:Name="LanguageButton" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnLanguageClick" />
                </Grid>
            </Border>
            <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=LanguageField}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, ElementName=LanguageField}">
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LanguageItems" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </StackPanel>
    </Border>

    <!-- font -->
    <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,12,12">
        <StackPanel>
            <TextBlock Text="{DynamicResource Settings.Font}" FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.Text}" />
            <TextBlock Text="{DynamicResource Settings.Font.Hint}" FontSize="{DynamicResource App.Font.Body}" Margin="0,6,0,12"
                       Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
            <Border x:Name="FontField" Height="36" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource App.Border}" Background="{DynamicResource App.Surface}">
                <Grid>
                    <TextBlock x:Name="FontLabel" Margin="12,0,36,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource App.Font.Body}" Foreground="{DynamicResource App.Text}"
                               TextTrimming="CharacterEllipsis" />
                    <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Margin="0,0,10,0"
                                             Foreground="{DynamicResource App.TextSoft}" />
                    <Button x:Name="FontButton" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnFontClick" />
                </Grid>
            </Border>
            <Popup x:Name="FontPopup" PlacementTarget="{Binding ElementName=FontField}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, ElementName=FontField}">
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FontItems" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </StackPanel>
    </Border>

    <!-- about: icon, version, publisher, licence - nothing else -->
    <Border Style="{StaticResource CardBorder}" Width="320" Margin="0,0,12,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/app.png" Width="40" Height="40" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings.About}" FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" />
                    <TextBlock x:Name="AboutVersion" FontSize="{DynamicResource App.Font.Body}" Margin="0,2,0,0"
                               Foreground="{DynamicResource App.TextSoft}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{DynamicResource Settings.About.Publisher}" FontSize="{DynamicResource App.Font.Body}" Margin="0,14,0,0"
                       Foreground="{DynamicResource App.Text}" />
            <TextBlock Text="{DynamicResource Settings.About.License}" FontSize="{DynamicResource App.Font.Meta}" Margin="0,4,0,14"
                       Foreground="{DynamicResource App.TextSoft}" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Click="OnOpenGithub" ToolTip="{DynamicResource Settings.About.Github}">
                    <materialDesign:PackIcon Kind="Github" Width="20" Height="20" />
                </Button>
                <Button Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="OnOpenBilibili" ToolTip="{DynamicResource Settings.About.Bilibili}">
                    <materialDesign:PackIcon Kind="TelevisionClassic" Width="20" Height="20" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- update: check, open the release page, read the changelog -->
    <Border Style="{StaticResource CardBorder}" Width="320" Margin="0,0,12,12">
        <StackPanel>
            <TextBlock Text="{DynamicResource Settings.Update}" FontSize="{DynamicResource App.Font.Title}" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.Text}" />
            <TextBlock x:Name="UpdateCurrent" FontSize="{DynamicResource App.Font.Body}" Margin="0,6,0,12"
                       Foreground="{DynamicResource App.TextSoft}" TextWrapping="Wrap" />
            <WrapPanel>
                <Button x:Name="CheckUpdateButton" Style="{StaticResource PillButton}" Margin="0,0,8,8"
                        Click="OnCheckUpdate" Content="{DynamicResource Settings.Update.Check}" />
                <Button Style="{StaticResource PillButtonOutline}" Margin="0,0,8,8"
                        Click="OnOpenRelease" Content="{DynamicResource Settings.Update.Open}" />
                <Button Style="{StaticResource PillButtonOutline}" Margin="0,0,0,8"
                        Click="OnOpenChangelog" Content="{DynamicResource Settings.Update.Log}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- theme cross-fade: a sheet of the outgoing background fades away after a palette swap -->
        <Border x:Name="ThemeFade" Grid.RowSpan="2" Panel.ZIndex="50" IsHitTestVisible="False"
                Opacity="0" Background="Transparent" />
    </Grid>
</Window>
