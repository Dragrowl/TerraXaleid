<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground, 108x108 viewport with the 72x72 safe zone centred.

  Geometry: a centred 4x4 grid of 10x10 cells with 4 gaps => 52x52 total, starting at 28.
  The previous version started at the left edge (x=18) and spanned 58.5, so launchers that
  mask to the safe zone cropped the right and bottom of the grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- grid cells: column x = 28, 42, 56, 70; row y = 28, 42, 56, 70 -->
    <path android:fillColor="#2B3442" android:pathData="M28,28h10v10h-10z" />
    <path android:fillColor="#2B3442" android:pathData="M42,28h10v10h-10z" />
    <path android:fillColor="#2B3442" android:pathData="M56,28h10v10h-10z" />
    <path android:fillColor="#2B3442" android:pathData="M70,28h10v10h-10z" />

    <path android:fillColor="#2B3442" android:pathData="M28,42h10v10h-10z" />
    <path android:fillColor="#4C9BE8" android:pathData="M42,42h10v10h-10z" />
    <path android:fillColor="#4C9BE8" android:pathData="M56,42h10v10h-10z" />
    <path android:fillColor="#2B3442" android:pathData="M70,42h10v10h-10z" />

    <path android:fillColor="#2B3442" android:pathData="M28,56h10v10h-10z" />
    <path android:fillColor="#4C9BE8" android:pathData="M42,56h10v10h-10z" />
    <path android:fillColor="#4C9BE8" android:pathData="M56,56h10v10h-10z" />
    <path android:fillColor="#2B3442" android:pathData="M70,56h10v10h-10z" />

    <path android:fillColor="#2B3442" android:pathData="M28,70h10v10h-10z" />
    <path android:fillColor="#2B3442" android:pathData="M42,70h10v10h-10z" />
    <path android:fillColor="#2B3442" android:pathData="M56,70h10v10h-10z" />
    <path android:fillColor="#2B3442" android:pathData="M70,70h10v10h-10z" />

    <!-- grass line, mirrored on the grid's horizontal axis (y = 54) -->
    <path
        android:pathData="M20,54H88"
        android:strokeColor="#57C96A"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
