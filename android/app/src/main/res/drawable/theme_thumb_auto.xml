<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme card thumbnail: follow system.
  The cut starts from the +x direction and turns 65 degrees counter-clockwise, so its direction is
  (cos65, -sin65) = (0.4226, -0.9063) through the centre of the 108x108 canvas. That makes it a steep
  line: it enters the top edge at x = 54 + 0.4226 * (54 / 0.9063) = 79.18 and leaves the bottom edge at
  x = 54 - 0.4226 * (54 / 0.9063) = 28.82.
  Light on the left of the cut, dark on the right; each half draws its own content clipped by its own
  polygon so the cut runs through the content, not between two flat blocks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- backgrounds -->
    <path android:fillColor="#FFFBF7F2" android:pathData="M0,0L79.18,0L28.82,108L0,108z" />
    <path android:fillColor="#FF12140F" android:pathData="M79.18,0L108,0L108,108L28.82,108z" />

    <!-- light half, clipped to the left polygon -->
    <group>
        <clip-path android:pathData="M0,0L79.18,0L28.82,108L0,108z" />
        <path android:fillColor="#FF4C6B43" android:pathData="M16,26h48a4,4 0 0 1 4,4v12a4,4 0 0 1 -4,4h-48a4,4 0 0 1 -4,-4v-12a4,4 0 0 1 4,-4z" />
        <path android:fillColor="#FFE2DDD3" android:pathData="M16,52h76a4,4 0 0 1 4,4v8a4,4 0 0 1 -4,4h-76a4,4 0 0 1 -4,-4v-8a4,4 0 0 1 4,-4z" />
        <path android:fillColor="#FFEDE8DF" android:pathData="M16,72h60a4,4 0 0 1 4,4v8a4,4 0 0 1 -4,4h-60a4,4 0 0 1 -4,-4v-8a4,4 0 0 1 4,-4z" />
    </group>

    <!-- dark half, clipped to the right polygon -->
    <group>
        <clip-path android:pathData="M79.18,0L108,0L108,108L28.82,108z" />
        <path android:fillColor="#FF7FA86B" android:pathData="M16,26h48a4,4 0 0 1 4,4v12a4,4 0 0 1 -4,4h-48a4,4 0 0 1 -4,-4v-12a4,4 0 0 1 4,-4z" />
        <path android:fillColor="#FF2A2F26" android:pathData="M16,52h76a4,4 0 0 1 4,4v8a4,4 0 0 1 -4,4h-76a4,4 0 0 1 -4,-4v-8a4,4 0 0 1 4,-4z" />
        <path android:fillColor="#FF1F231C" android:pathData="M16,72h60a4,4 0 0 1 4,4v8a4,4 0 0 1 -4,4h-60a4,4 0 0 1 -4,-4v-8a4,4 0 0 1 4,-4z" />
    </group>

    <!-- hairline along the cut, one unit wide, so the two halves stay separated -->
    <path android:fillColor="#33000000" android:pathData="M79.18,0L80.6,0L30.24,108L28.82,108z" />
</vector>
