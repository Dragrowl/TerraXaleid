root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs}]
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ij_kotlin_allow_trailing_comma = true

[*.{kts,json,yml,yaml,xml}]
indent_size = 2

[*.{ps1,md}]
indent_size = 4
trim_trailing_whitespace = false

[*.py]
indent_size = 4
